rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isRequestOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /vehicles/{vehicleId} {
      allow create: if isRequestOwner();
      allow read, update, delete: if isResourceOwner();
    }

    match /gasStations/{stationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow create: if isRequestOwner();
      allow read, update, delete: if isResourceOwner();
    }

    match /fuelReports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if true;
      allow update, delete: if isResourceOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}