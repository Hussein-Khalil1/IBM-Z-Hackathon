# ─────────────────────────────────────────────────────────────
#  FuelEquity — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local or .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Firebase (Dev) ────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_DEV_API_KEY=
EXPO_PUBLIC_FIREBASE_DEV_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DEV_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_DEV_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_DEV_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_DEV_APP_ID=
EXPO_PUBLIC_FIREBASE_DEV_MEASUREMENT_ID=

# ── Firebase (Prod) ───────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_PROD_API_KEY=
EXPO_PUBLIC_FIREBASE_PROD_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROD_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_PROD_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_PROD_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_PROD_APP_ID=
EXPO_PUBLIC_FIREBASE_PROD_MEASUREMENT_ID=

# ── App environment (dev | prod) ──────────────────────────────
EXPO_PUBLIC_APP_ENV=dev

# ── Google Sign-In (OAuth Client IDs) ────────────────────────
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ── Stripe ────────────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY goes in Cloud Functions env, NOT here

# ── IBM watsonx.ai ────────────────────────────────────────────
EXPO_PUBLIC_WATSONX_PROJECT_ID=
EXPO_PUBLIC_WATSONX_REGION=us-south
# WATSONX_API_KEY goes in Cloud Functions env, NOT here

# ── Google Maps ───────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── OpenWeatherMap ────────────────────────────────────────────
EXPO_PUBLIC_OPENWEATHER_API_KEY=

# ── TollGuru ──────────────────────────────────────────────────
EXPO_PUBLIC_TOLLGURU_API_KEY=
