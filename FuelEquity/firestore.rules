rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isTripMember(tripData) {
      return isAuth() && (
        request.auth.uid == tripData.ownerId ||
        request.auth.uid in tripData.riderIds
      );
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    // ── users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── trips ──────────────────────────────────────────────────────────────────
    match /trips/{tripId} {
      // Any authenticated user can read (required for invite code lookup before joining)
      allow read:   if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.ownerId;
      // Owner can make any update; riders can only update riderIds + updatedAt when joining
      allow update: if isAuth() && request.auth.uid == resource.data.ownerId;
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderIds', 'updatedAt']) &&
        request.auth.uid in request.resource.data.riderIds;
      allow delete: if isAuth() && request.auth.uid == resource.data.ownerId;

      // ── expenses (subcollection) ──────────────────────────────────────────
      match /expenses/{expenseId} {
        allow read, write: if isTripMember(tripDoc(tripId));
      }

      // ── riders (subcollection) ────────────────────────────────────────────
      match /riders/{riderId} {
        allow read: if isAuth();
        // Owner can add any rider; riders can add themselves (self-join via invite code)
        allow create: if isAuth() && (
          request.auth.uid == tripDoc(tripId).ownerId ||
          request.auth.uid == riderId
        );
        // Owner or the rider themselves may update
        allow update: if isAuth() && (
          request.auth.uid == tripDoc(tripId).ownerId ||
          request.auth.uid == riderId
        );
      }
    }

    // ── greenMiles ─────────────────────────────────────────────────────────────
    match /greenMiles/{recordId} {
      allow read:           if isOwner(resource.data.userId);
      allow create:         if isAuth() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ── gasReports (community feed) ────────────────────────────────────────────
    match /gasReports/{reportId} {
      allow read:           if isAuth();
      allow create:         if isAuth() && request.auth.uid == request.resource.data.reportedByUserId;
      allow update, delete: if isOwner(resource.data.reportedByUserId);
    }
  }
}
